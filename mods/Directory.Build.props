<Project>

  <!-- Inherit the repo-wide settings from the nearest parent Directory.Build.props. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- SMAPI 4.x mods run on the game's .NET 6 runtime, not the repo default (net10.0). -->
    <TargetFramework>net6.0</TargetFramework>
  </PropertyGroup>

</Project>
